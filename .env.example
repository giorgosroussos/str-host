# Local development environment (specs/11-infrastructure-operations.md §1).
# `make setup` copies this file to .env and generates APP_KEY. Values exported in the
# shell win over this file, for Laravel and for Docker Compose alike, which is how
# `make clean-start` runs an isolated copy on other ports.

APP_NAME="STR Host"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_PORT=8000
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=el_GR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 16 from docker-compose.yml. DB_PORT is the host port Compose publishes;
# change it when another service or clone already uses it.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54316
DB_DATABASE=str_host
DB_USERNAME=str_host
DB_PASSWORD=str_host_local_only
# Tests use the database str_host_test on the same server (phpunit.xml); Compose creates
# it on first start, so tests never touch the development data.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Development email never reaches a real recipient (specs/11-infrastructure-operations.md §1):
# `log` writes it to storage/logs. To use the mail-trap account instead, set MAIL_MAILER=smtp
# and its host, port, username and password here (never commit them).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@str-host.test"
MAIL_FROM_NAME="${APP_NAME}"

# Inertia DevTools would record every request's page props to storage/ in the local
# environment; off by default so no personal data lands on disk (D-017).
INERTIA_DEVTOOLS_ENABLED=false

# Vite dev server port (make dev).
VITE_PORT=5173
VITE_APP_NAME="${APP_NAME}"
